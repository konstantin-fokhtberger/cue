{
  "name": "cue",
  "version": "0.1.0",
  "description": "Open-source macOS invisible AI overlay — three separate inputs (screen, mic, system audio) into an LLM. A Cluely-style copilot for meetings and coding problems.",
  "license": "GPL-3.0-or-later",
  "author": "cue",
  "main": "main.js",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"AGENTS.md\" \".github/**/*.yml\" \"docs/**/*.md\" \"test/**/*.{js,mjs,ts}\" \"tools/**/*.mjs\" \"*.config.mjs\" \"*.json\"",
    "typecheck": "tsc --noEmit",
    "validate:traceability": "node tools/validate-traceability.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm run validate:traceability && npm run test:coverage && npm run audit:production",
    "quality:full": "npm run quality && npm run test:mutation",
    "pack": "electron-builder --dir",
    "pack:ci": "node tools/package-macos.mjs --adhoc",
    "pack:local": "node tools/package-macos.mjs --local",
    "dist": "electron-builder --mac zip",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.cue.overlay",
    "productName": "cue",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "cue transcribes your microphone so it can help you in conversations.",
        "NSCameraUsageDescription": "cue does not use the camera.",
        "NSAudioCaptureUsageDescription": "cue captures system audio to transcribe the other participant in a call."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "keywords": [
    "electron",
    "overlay",
    "ai",
    "assistant",
    "screencapturekit",
    "macos"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.7.0",
    "fast-check": "4.9.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^0.3.0",
    "lucide-static": "^0.468.0",
    "openai": "^4.73.0"
  }
}
